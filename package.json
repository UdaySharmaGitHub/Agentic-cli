{
  "name": "agentic-cli",
  "version": "4.2.0",
  "description": "A terminal-based agentic CLI powered by Google Gemini with a ReAct agent loop",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentic": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@google/generative-ai": "^0.21.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.5",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UdaySharmaGitHub/Agentic-cli.git"
  },
  "bugs": {
    "url": "https://github.com/UdaySharmaGitHub/Agentic-cli/issues"
  },
  "homepage": "https://github.com/UdaySharmaGitHub/Agentic-cli#readme",
  "license": "MIT",
  "keywords": [
    "cli",
    "agent",
    "gemini",
    "ai",
    "typescript",
    "repl"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}