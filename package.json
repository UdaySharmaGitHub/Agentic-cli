{
  "name": "agentic-cli",
  "version": "4.2.0",
  "description": "A terminal-based agentic CLI powered by any OpenAI-compatible API (LiteLLM Proxy, OpenAI, etc.) with a ReAct agent loop",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentic": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.5",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.x.x",
    "ora": "^8.1.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UdaySharmaGitHub/Agentic-cli.git"
  },
  "bugs": {
    "url": "https://github.com/UdaySharmaGitHub/Agentic-cli/issues"
  },
  "homepage": "https://github.com/UdaySharmaGitHub/Agentic-cli#readme",
  "license": "MIT",
  "keywords": [
    "cli",
    "agent",
    "ai",
    "typescript",
    "repl"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}